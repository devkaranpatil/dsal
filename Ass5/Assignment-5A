#include <iostream>
using namespace std;

class Search
{
    int arr[100];
    int n;

public:
    void input()
    {
        cout << "Enter number of elements: ";
        cin >> n;

        cout << "Enter elements in ascending or descending order: ";
        for (int i = 0; i < n; i++)
        {
            cin >> arr[i];
        }
    }

    void search(int key)
    {
        for (int i = 0; i < n; i++)
        {
            if (arr[i] == key)
            {
                cout << "Element found at position " << i + 1 << endl;
                return;
            }
        }

        cout << "Element not found" << endl;
    }

    void binarySearch(int key)
    {
        if (n <= 0)
        {
            cout << "Array is empty\n";
            return;
        }

        int start = 0;
        int end = n - 1;

        bool ascending = (arr[start] <= arr[end]);

        while (start <= end)
        {
            int mid = start + (end - start) / 2;

            if (arr[mid] == key)
            {
                cout << "Element found at position " << mid + 1 << endl;
                return;
            }

            if (ascending)
            {
                if (arr[mid] < key)
                    start = mid + 1;
                else
                    end = mid - 1;
            }
            else
            {
                if (arr[mid] < key)
                    end = mid - 1;
                else
                    start = mid + 1;
            }
        }

        cout << "Element not found" << endl;
    }
};

int main()
{
    Search s;
    int key;

    s.input();

    cout << "Enter element to search: ";
    cin >> key;

    cout << "\nLinear Search:\n";
    s.search(key);

    cout << "\nBinary Search:\n";
    s.binarySearch(key);

    return 0;
}